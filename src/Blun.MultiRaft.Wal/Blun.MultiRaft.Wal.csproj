<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <RootNamespace>Blun.MultiRaft.Wal</RootNamespace>
    <!--
      AnalysisLevel=latest in Directory.Build.props picks the rule *version*, not the rule *set*: most of the
      CA18xx performance rules and CA2007 are off by default and stay off no matter how high the level goes.
      Turned on here rather than repo-wide because solution-wide these two modes produce ~920 warnings, almost
      all of them CA2007 in the demo and test projects, where ConfigureAwait is noise rather than a finding.
      This is the one assembly that ships as a library onto someone else's thread pool, so it is the one that
      has to hold the line, and with TreatWarningsAsErrors it does so at build time.
    -->
    <AnalysisModePerformance>All</AnalysisModePerformance>
    <AnalysisModeReliability>All</AnalysisModeReliability>
    <PackageId>Blun.MultiRaft.Wal</PackageId>
    <Description>Write-ahead log abstraction and implementations for Blun.MultiRaft. Depends on nothing else in the library, so it can be referenced -- or replaced -- on its own.</Description>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

</Project>
