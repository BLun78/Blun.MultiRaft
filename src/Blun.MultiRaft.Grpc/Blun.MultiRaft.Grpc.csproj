<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <RootNamespace>Blun.MultiRaft.Grpc</RootNamespace>
    <PackageId>Blun.MultiRaft.Grpc</PackageId>
    <Description>gRPC transport for Blun.MultiRaft. One multiplexed bidirectional stream per node pair, carrying every group.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Net.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Blun.MultiRaft/Blun.MultiRaft.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/raft.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
