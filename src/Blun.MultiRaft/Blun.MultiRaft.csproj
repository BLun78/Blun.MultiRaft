<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Types and non-obvious members carry docs; requiring one on every operator== is noise, not rigour. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>    
    <RootNamespace>Blun.MultiRaft</RootNamespace>
    <!--
      AnalysisLevel=latest in Directory.Build.props picks the rule *version*, not the rule *set*: most of the
      CA18xx performance rules and CA2007 are off by default and stay off no matter how high the level goes.
      Turned on here rather than repo-wide because solution-wide these two modes produce ~920 warnings, almost
      all of them CA2007 in the demo and test projects, where ConfigureAwait is noise rather than a finding.
      This is the one assembly that ships as a library onto someone else's thread pool, so it is the one that
      has to hold the line, and with TreatWarningsAsErrors it does so at build time.
    -->
    <AnalysisModePerformance>All</AnalysisModePerformance>
    <AnalysisModeReliability>All</AnalysisModeReliability>
    <PackageId>Blun.MultiRaft</PackageId>
    <Description>Multi-Raft consensus library with leader-driven asymmetric replication and a pluggable write-ahead log.</Description>
  </PropertyGroup>

  <!-- net11-only switches live here, never unconditionally. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="K4os.Compression.LZ4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Blun.MultiRaft.Wal/Blun.MultiRaft.Wal.csproj" />
  </ItemGroup>

</Project>
