<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- D-002: net11.0 carries runtime-async=on, an experimental switch that changes how async methods
         execute, on the library whose failure class CLAUDE.md itself calls "intermittent rather than
         deterministic". Testing only net10.0 left exactly that behavior unverified on every platform. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Threading a TestContext token through every await adds noise without changing what is verified. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Blun.MultiRaft.Wal/Blun.MultiRaft.Wal.csproj" />
    <ProjectReference Include="../../src/Blun.MultiRaft/Blun.MultiRaft.csproj" />
    <ProjectReference Include="../../src/Blun.MultiRaft.Grpc/Blun.MultiRaft.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
