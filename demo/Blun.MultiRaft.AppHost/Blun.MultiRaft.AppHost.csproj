<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.1" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>blun-multiraft-apphost</UserSecretsId>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

  <!-- The control plane serves HTTP from inside the app host process; nothing else here needs ASP.NET Core. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Blun.MultiRaft.Node/Blun.MultiRaft.Node.csproj" />
    <ProjectReference Include="../Blun.MultiRaft.Observer/Blun.MultiRaft.Observer.csproj" />
  </ItemGroup>

</Project>
