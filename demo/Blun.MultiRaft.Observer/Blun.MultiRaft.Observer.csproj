<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <RootNamespace>Blun.MultiRaft.Observer</RootNamespace>
    <UserSecretsId>blun-multiraft-observer</UserSecretsId>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Without this the minimal-API handlers are bound by reflection, which IsAotCompatible correctly
         reports as unsafe. The generator turns each Map* call into generated binding code instead. -->
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

</Project>
